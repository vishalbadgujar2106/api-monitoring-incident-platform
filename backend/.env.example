PORT=4000

# Matches the default credentials in the root docker-compose.yml (via ../.env).
# If you change POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB there, update this too.
# In production, set this to your hosted Postgres connection string instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/api_monitoring

# Set to "true" if your hosted Postgres requires TLS (most managed
# providers do). Leave unset for local development.
DATABASE_SSL=false

# The deployed frontend's origin, for CORS. http://localhost:5173 (the
# Vite dev server) is always allowed and does not need to be listed here.
# Required in production — requests from any other origin are rejected.
FRONTEND_ORIGIN=https://your-frontend-domain.example.com

# Used by POST /api/incidents/:id/analyze (AI-powered root-cause analysis).
# Only AI_PROVIDER=openai is supported. Leave AI_API_KEY unset to disable the feature.
AI_PROVIDER=openai
AI_MODEL=gpt-5-mini
AI_API_KEY=sk-your-key-here
