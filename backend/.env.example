PORT=4000

# Matches the default credentials in the root docker-compose.yml (via ../.env).
# If you change POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB there, update this too.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/api_monitoring

# Used by POST /api/incidents/:id/analyze (AI-powered root-cause analysis).
# Only AI_PROVIDER=openai is supported. Leave AI_API_KEY unset to disable the feature.
AI_PROVIDER=openai
AI_MODEL=gpt-5-mini
AI_API_KEY=sk-your-key-here
